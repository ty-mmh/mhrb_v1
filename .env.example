# Copy to .env for Docker Compose. This file contains no credentials.
# Configure a provider before starting dialogue in the management UI.
MAHOROBA_PROVIDER_BASE_URL=http://host.docker.internal:8080/v1
MAHOROBA_PROVIDER_MODEL=replace-with-your-model
# Permit only the Docker Desktop host HTTP provider with an explicit port.
# Set false when using an HTTPS provider instead.
MAHOROBA_PROVIDER_ALLOW_DOCKER_HOST_HTTP=true
# Uncomment and replace the value if your provider requires authentication.
# MAHOROBA_PROVIDER_API_KEY=replace-with-your-key
# Omit an unused API key completely; an explicitly empty key is invalid.

# Host and container ports move together; publication stays on 127.0.0.1.
MAHOROBA_ADMIN_PORT=8788
MAHOROBA_DIALOGUE_PORT=8787
# Opt in only when a private proxy such as Tailscale Serve targets dialogue.
# This never relaxes the administration Host/Origin boundary.
MAHOROBA_DIALOGUE_ALLOW_REMOTE=false

# A separate Compose project uses independent data and files volumes.
# COMPOSE_PROJECT_NAME=mahoroba
